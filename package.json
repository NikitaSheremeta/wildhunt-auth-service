{
  "name": "wildhunt-auth-service",
  "version": "1.0.0",
  "private": true,
  "main": "dist/src/api/v1/index.cjs",
  "scripts": {
    "build": "rollup -c",
    "start": "NODE_ENV=production DOTENV_CONFIG_PATH=./.env node dist/src/api/v1/index.cjs",
    "serve": "NODE_ENV=development DOTENV_CONFIG_PATH=./.env nodemon -r dotenv/config src/api/v1/index.js",
    "prettier": "prettier --write './**/*.js'",
    "eslint": "eslint --fix './**/*.js'"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^5.0.1",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "handlebars": "^4.7.7",
    "helmet": "^4.6.0",
    "joi": "^17.4.2",
    "jsonwebtoken": "^8.5.1",
    "mysql2": "^2.3.3",
    "nodemailer": "^6.7.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^8.2.0",
    "nodemon": "^2.0.22",
    "prettier": "^2.4.1",
    "rollup": "^4.51.0",
    "rollup-plugin-copy": "^3.5.0"
  }
}

{
  "name": "wildhunt-server-personal-cabinet",
  "version": "1.0.0",
  "description": "Back-end side",
  "main": "src/api/v1/index.js",
  "scripts": {
    "serve": "cross-env NODE_ENV=development nodemon src/api/v1/index.js",
    "start": "cross-env NODE_ENV=production node src/api/v1/index.js",
    "eslint": "eslint --fix './**/*.js'",
    "prettier": "prettier --write './**/*.js'",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^5.0.1",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "handlebars": "^4.7.7",
    "helmet": "^4.6.0",
    "joi": "^17.4.2",
    "jsonwebtoken": "^8.5.1",
    "mysql2": "^2.3.3",
    "newrelic": "^8.6.0",
    "nodemailer": "^6.7.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.16.0",
    "@babel/core": "^7.16.0",
    "@babel/node": "^7.16.0",
    "@babel/preset-env": "^7.16.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.2.0",
    "husky": "^7.0.4",
    "lint-staged": "^11.2.6",
    "nodemon": "^2.0.22",
    "prettier": "^2.4.1"
  }
}
